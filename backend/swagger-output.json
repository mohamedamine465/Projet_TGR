          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "summary": "Connexion utilisateur",
        "description": "Authentifie un utilisateur et renvoie un JWT. Gère aussi le cas de la première connexion (mot de passe provisoire).",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Email et mot de passe",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "test@tgr.gov.ma"
                },
                "password": {
                  "type": "string",
                  "example": "MotDePasseSecret"
                }
              },
              "required": [
                "email",
                "password"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connexion réussie. Retourne le JWT et les informations utilisateur.",
            "schema": {
              "type": "object",
              "properties": {
                "": {
                  "type": "boolean",
                  "example": false
                },
                "token": {
                  "type": "string",
                  "example": "eyJhbGciOiJIUzI1NiIsInR5..."
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "idUtilisateur": {
                      "type": "number",
                      "example": 1
                    },
                    "nom": {
                      "type": "string",
                      "example": "Doe"
                    },
                    "prenom": {
                      "type": "string",
                      "example": "John"
                    },
                    "email": {
                      "type": "string",
                      "example": "test@tgr.gov.ma"
                    },
                    "typeUtilisateur": {
                      "type": "object",
                      "properties": {
                        "idType": {
                          "type": "number",
                          "example": 1
                        },
                        "libelleType": {
                          "type": "string",
                          "example": "Valideur / Administrateur"
                        }
                      },
                      "required": [
                        "idType",
                        "libelleType"
                      ]
                    },
                    "profils": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "idProfil": {
                            "type": "number",
                            "example": 1
                          },
                          "libelleProfil": {
                            "type": "string",
                            "example": "Dette du Tresor"
                          }
                        },
                        "required": [
                          "idProfil",
                          "libelleProfil"
                        ]
                      }
                    }
                  },
                  "required": [
                    "idUtilisateur",
                    "nom",
                    "prenom",
                    "email",
                    "typeUtilisateur",
                    "profils"
                  ]
                }
              },
              "required": [
                "",
                "token",
                "user"
              ],
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Paramètres manquants."
          },
          "401": {
            "description": "Identifiants incorrects."
          },
          "403": {
            "description": "Première connexion, changement de mot de passe obligatoire.",
            "schema": {
              "type": "object",
              "properties": {
                "first_login": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Première connexion détectée..."
                },
                "email": {
                  "type": "string",
                  "example": "test@tgr.gov.ma"
                }
              },
              "required": [
                "first_login",
                "message",
                "email"
              ],
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "summary": "Changer le mot de passe",
        "description": "Permet de changer le mot de passe. Obligatoire après une première connexion. Peut être appelé avec ou sans JWT. Si appelé sans JWT (première connexion), email est requis.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Email (si non authentifié), mot de passe actuel et nouveau mot de passe",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "test@tgr.gov.ma"
                },
                "currentPassword": {
                  "type": "string",
                  "example": "ancienMotDePasse"
                },
                "newPassword": {
                  "type": "string",
                  "example": "NouveauMotDePasse8!"
                }
              },
              "required": [
                "currentPassword",
                "newPassword"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mot de passe modifié avec succès."
          },
          "400": {
            "description": "Erreur de validation des champs ou mot de passe identique."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
